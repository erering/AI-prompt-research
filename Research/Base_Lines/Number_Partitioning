#include <bits/stdc++.h>
using namespace std;
using ll = long long;

static vector<ll> makeSums(const vector<ll>& a, int l, int r) {
    int k = r - l;
    size_t n = 1ULL << k;
    vector<ll> sums(n);
    size_t sz = 1;
    for (int i = 0; i < k; ++i) {
        ll x = a[l + i];
        for (size_t j = 0; j < sz; ++j) sums[sz + j] = sums[j] + x;
        sz <<= 1;
    }
    return sums;
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int N;
    if (!(cin >> N)) return 0;
    vector<ll> a(N);
    ll S = 0;
    for (int i = 0; i < N; ++i) { cin >> a[i]; S += a[i]; }

    ll opt = S & 1LL;
    int n1 = N / 2;
    int n2 = N - n1;

    vector<ll> v = makeSums(a, n1, N);
    sort(v.begin(), v.end());

    ll best = S;
    size_t total = 1ULL << n1;
    ll cur = 0;
    size_t prevGray = 0;

    for (size_t mask = 0; mask < total; ++mask) {
        if (mask) {
            size_t gray = mask ^ (mask >> 1);
            size_t diff = gray ^ prevGray;
            int bit = __builtin_ctzll((unsigned long long)diff);
            if (gray & diff) cur += a[bit];
            else cur -= a[bit];
            prevGray = gray;
        }
        ll need = S / 2 - cur;
        auto it = lower_bound(v.begin(), v.end(), need);
        if (it != v.end()) { ll d = llabs(S - 2*(cur+*it)); if (d < best) best = d; }
        if (it != v.begin()) { --it; ll d = llabs(S - 2*(cur+*it)); if (d < best) best = d; }
        if (best == opt) break;
    }

    cout << best << '\n';
    return 0;
}
